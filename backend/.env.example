# ================================================================
# Cerea backend configuration
# Copy to backend/.env and fill in real values. Never commit .env.
# ================================================================

# Database connection (SQLAlchemy URL). MariaDB/MySQL or PostgreSQL both work.
# MariaDB / MySQL: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# PostgreSQL (e.g. Supabase "Session pooler"): postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=mysql+pymysql://cerea_user:change-me@localhost:3306/cerea

# Secret used to sign login tokens (JWT). Use a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Login token lifetime in minutes (480 = 8 hours)
TOKEN_EXPIRE_MINUTES=480

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "Login as Guest" button: read-only access to all apps and announcements
# for everyone, without a NIK/password. Off unless set to true.
GUEST_LOGIN_ENABLED=false
# Guest session length in minutes
GUEST_TOKEN_MINUTES=60

# Container only: set to true to load demo departments/users/apps/announcements
# on startup (the Docker image runs seed.py before starting the server).
SEED_DEMO=false

# Used by seed.py — the first admin account.
# Leave ADMIN_PASSWORD empty to generate a random one (printed once).
ADMIN_NIK=admin
ADMIN_PASSWORD=

# Used by `python seed.py --demo` — password for all demo users.
# Leave empty to generate a random one (printed once).
DEMO_USER_PASSWORD=

# Serverless hosts (set automatically when VERCEL is present; override only if needed)
# UPLOADS_ENABLED=false      # disable icon upload endpoint/static files (read-only filesystem)
# DB_POOL=null               # no local connection pool (use the provider's pooler)
# AUTO_CREATE_TABLES=false   # skip create_all on startup once the tables exist
