# ================================================================
# Cerea backend configuration
# Copy to backend/.env and fill in real values. Never commit .env.
# ================================================================

# MariaDB / MySQL connection (SQLAlchemy URL)
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://cerea_user:change-me@localhost:3306/cerea

# Secret used to sign login tokens (JWT). Use a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Login token lifetime in minutes (480 = 8 hours)
TOKEN_EXPIRE_MINUTES=480

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email domain for Microsoft sign-in ({NIK}@EMAIL_DOMAIN); keep in sync with VITE_EMAIL_DOMAIN
EMAIL_DOMAIN=example.com

# Microsoft sign-in (optional). The server verifies every Microsoft ID token
# against these values; use the same IDs as VITE_MSAL_CLIENT_ID / VITE_MSAL_TENANT_ID.
# Leave empty to disable Microsoft sign-in (the endpoint then returns 503).
MSAL_CLIENT_ID=
MSAL_TENANT_ID=

# "Login as Guest" button: read-only access to General Apps and announcements
# for everyone, without a NIK/password. Off unless set to true.
GUEST_LOGIN_ENABLED=false
# Guest session length in minutes
GUEST_TOKEN_MINUTES=60

# Used by seed.py — the first admin account.
# Leave ADMIN_PASSWORD empty to generate a random one (printed once).
ADMIN_NIK=admin
ADMIN_PASSWORD=

# Used by `python seed.py --demo` — password for all demo users.
# Leave empty to generate a random one (printed once).
DEMO_USER_PASSWORD=
