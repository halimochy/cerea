# ================================================================
# Cerea frontend configuration (Vite)
# Copy to frontend/.env and fill in real values. Never commit .env.
# All VITE_* values are embedded in the built JS — do not put secrets here.
# ================================================================

# Backend origin used to load uploaded icons in production builds
# (e.g. https://api.example.com). Leave empty when the API is served
# from the same origin; in development it defaults to http://localhost:8000.
VITE_API_BASE_URL=
